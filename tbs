-- ==================== GELİŞMİŞ MOVEMENT AI ====================
RunService.Heartbeat:Connect(function(dt)
    if not (G.MovementAI or G.PerfMode) then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = movementData[p]
                if not d then
                    d = {
                        lastPos = hrp.Position,
                        lastTime = elapsedTime,
                        dashUntil = 0,
                        aimbotUntil = 0,
                        speed = 0,
                        avgSpeed = 16,
                        lastMoveTime = elapsedTime
                    }
                    movementData[p] = d
                end
                local dt2 = elapsedTime - d.lastTime
                if dt2 >= 0.1 then
                    local dist = (hrp.Position - d.lastPos).Magnitude
                    local speed = dist / dt2
                    d.speed = speed
                    d.avgSpeed = d.avgSpeed * 0.7 + speed * 0.3

                    if speed > 3 then d.lastMoveTime = elapsedTime end

                    -- Speed/Dash/TP tespiti
                    if speed > 30 and not hum.PlatformStand then
                        d.dashUntil = elapsedTime + 3
                    end

                    -- Aimbot/Auto Parry
                    if speed > 15 and d.avgSpeed > 10 then
                        local lookDir = hrp.CFrame.LookVector
                        local moveDir = (hrp.Position - d.lastPos).Unit
                        if lookDir:Dot(moveDir) > 0.9 then
                            d.aimbotUntil = elapsedTime + 2
                        end
                    end

                    -- Infinite Jump
                    if not hum.FloorMaterial and speed > 5 then
                        d.aimbotUntil = elapsedTime + 1
                    end

                    d.lastPos = hrp.Position
                    d.lastTime = elapsedTime
                end
            end
        end
    end
    for p, _ in pairs(movementData) do
        if not p.Parent or not p.Character then movementData[p] = nil end
    end
end)

-- ==================== ANA LOOP ====================
RunService.Heartbeat:Connect(function(dt)
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum then return end

    if G.Speed then
        myHum.WalkSpeed = Settings.WalkSpeed * Settings._BoostWalk
    else
        myHum.WalkSpeed = 16
    end
    if G.Jump then
        myHum.UseJumpPower = true
        myHum.JumpPower = Settings.JumpPower * Settings._BoostJump
    end

    if myHum.Health <= 0 then return end

    local nearest, minDist = nil, 200
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (myHrp.Position - root.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = p
                end
            end
        end
    end

    if G.Dash then
        dashCooldown = dashCooldown - dt
        if dashCooldown <= 0 and nearest and minDist < 1.5 then
            local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local frontPos = tHrp.Position + tHrp.CFrame.LookVector * 2
                myHrp.CFrame = CFrame.lookAt(frontPos, tHrp.Position)
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                dashCooldown = 0.4
            end
        end
    end

    if G.Stick then
        stickCooldown = stickCooldown - dt
        if stickCooldown <= 0 and nearest and minDist < 3.5 then
            local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local lookVec = tHrp.CFrame.LookVector
                local hLook = Vector3.new(lookVec.X, 0, lookVec.Z)
                if hLook.Magnitude < 0.01 then hLook = Vector3.new(0, 0, -1) end
                hLook = hLook.Unit
                local behindPos = tHrp.Position - hLook * 2.5
                myHrp.CFrame = CFrame.lookAt(behindPos, behindPos + hLook)
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                stickCooldown = 2
            end
        end
    end
end)

